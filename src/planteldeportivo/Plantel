package planteldeportivo;

import java.util.Arrays;

public class Plantel {
    private Jugador[] jugadores;
    private int cantidad;

    public Plantel(int capacidadInicial) {
        if (capacidadInicial <= 0) {
            System.out.println("Capacidad inválida (" + capacidadInicial + "). Se usa 5 por defecto.");
            capacidadInicial = 5;
        }
        jugadores = new Jugador[capacidadInicial];
        cantidad = 0;
    }

    public int getCantidad() {
        return cantidad;
    }

    public int getCapacidad() {
        return jugadores.length;
    }

    public boolean agregar(Jugador j) {
        if (j == null) {
            System.out.println("Error: no se puede agregar un jugador null.");
            return false;
        }
        if (cantidad == jugadores.length) {
            int nuevaCapacidad = jugadores.length * 2;
            System.out.println("Capacidad máxima alcanzada (" + jugadores.length
                    + "). Duplicando array a " + nuevaCapacidad + " casillas...");
            jugadores = Arrays.copyOf(jugadores, nuevaCapacidad);
        }
        jugadores[cantidad] = j;
        cantidad++;
        System.out.println("Jugador agregado: " + j);
        return true;
    }

    public Jugador buscarPorDorsal(int dorsal) {
        for (int i = 0; i < cantidad; i++) {
            if (jugadores[i].getDorsal() == dorsal) {
                return jugadores[i];
            }
        }
        return null;
    }

    public Jugador buscarPorNombre(String nombre) {
        if (nombre == null) {
            return null;
        }
        for (int i = 0; i < cantidad; i++) {
            if (jugadores[i] != null && jugadores[i].getNombre().equalsIgnoreCase(nombre)) {
                return jugadores[i];
            }
        }
        return null;
    }

    public boolean eliminar(int dorsal) {
        int indice = -1;
        for (int i = 0; i < cantidad; i++) {
            if (jugadores[i].getDorsal() == dorsal) {
                indice = i;
                break;
            }
        }
        if (indice == -1) {
            return false;
        }
        // Desplazar a la izquierda para tapar el hueco
        for (int i = indice; i < cantidad - 1; i++) {
            jugadores[i] = jugadores[i + 1];
        }
        // Limpiar la referencia residual del final
        jugadores[cantidad - 1] = null;
        cantidad--;
        return true;
    }

    public void ordenarPorGolesDescendente() {
        for (int i = 0; i < cantidad - 1; i++) {
            int posMayor = i;
            for (int j = i + 1; j < cantidad; j++) {
                if (jugadores[j].getGoles() > jugadores[posMayor].getGoles()) {
                    posMayor = j;
                }
            }
            if (posMayor != i) {
                Jugador temp = jugadores[i];
                jugadores[i] = jugadores[posMayor];
                jugadores[posMayor] = temp;
            }
        }
    }

    public void listar() {
        for (int i = 0; i < cantidad; i++) {
            System.out.println(jugadores[i]);
        }
    }

    public Jugador[] getJugadores() {
        return Arrays.copyOf(jugadores, cantidad);
    }

    // ---- Desafíos de extensión ----

    public double calcularPromedioGoles() {
        if (cantidad == 0) {
            return 0;
        }
        int total = 0;
        for (int i = 0; i < cantidad; i++) {
            total += jugadores[i].getGoles();
        }
        return (double) total / cantidad;
    }

    public void ordenarPorDorsalAscendente() {
        for (int i = 0; i < cantidad - 1; i++) {
            int posMenor = i;
            for (int j = i + 1; j < cantidad; j++) {
                if (jugadores[j].getDorsal() < jugadores[posMenor].getDorsal()) {
                    posMenor = j;
                }
            }
            if (posMenor != i) {
                Jugador temp = jugadores[i];
                jugadores[i] = jugadores[posMenor];
                jugadores[posMenor] = temp;
            }
        }
    }
}
