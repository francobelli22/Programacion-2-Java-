package planteldeportivo;

public class Jugador {
    private final String nombre;
    private final int dorsal;
    private int goles;

    public Jugador(String nombre, int dorsal, int goles) {
        if (nombre == null || nombre.isBlank()) {
            System.out.println("Aviso: nombre nulo o en blanco. Se asigna \"Sin nombre\".");
            this.nombre = "Sin nombre";
        } else {
            this.nombre = nombre;
        }

        if (dorsal <= 0) {
            System.out.println("Aviso: dorsal inválido (" + dorsal + ") para " + this.nombre + ". Se asigna 99.");
            this.dorsal = 99;
        } else {
            this.dorsal = dorsal;
        }

        if (goles < 0) {
            System.out.println("Aviso: goles negativos (" + goles + ") para " + this.nombre + ". Se asigna 0.");
            this.goles = 0;
        } else {
            this.goles = goles;
        }
    }

    public String getNombre() {
        return nombre;
    }

    public int getDorsal() {
        return dorsal;
    }

    public int getGoles() {
        return goles;
    }

    public void anotarGoles(int cantidad) {
        if (cantidad > 0) {
            goles += cantidad;
        }
    }

    @Override
    public String toString() {
        return "#" + dorsal + " " + nombre + " (" + goles + " goles)";
    }
}
